[Unit]
Description=CamUI-WebRTC Application
After=network.target mediamtx.service pipewire.service pipewire-pulse.service wireplumber.service
Requires=mediamtx.service pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=/home/pi/CamUI-WebRTC
ExecStartPre=/bin/sh -c 'until pactl info >/dev/null 2>&1; do sleep 1; done'
ExecStartPre=/bin/sh -c 'until ss -tln 2>/dev/null | grep -q ":8554 "; do sleep 1; done'
ExecStart=/home/pi/CamUI-WebRTC/venv/bin/gunicorn \
	--worker-class geventwebsocket.gunicorn.workers.GeventWebSocketWorker \
	--workers 1 \
	--bind 0.0.0.0:80 \
	--chdir /home/pi/CamUI-WebRTC \
	--env BATTERY_FILE=/run/battery.json \
	app:app
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
